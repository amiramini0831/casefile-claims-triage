# Template for .env. Do not put real values in this file.
#
# You normally do not need to copy it by hand: scripts/setup_database.py
# creates .env, fills in these defaults and generates the passwords.
# .env is ignored by git and must never be committed.

CASEFILE_DB_HOST=127.0.0.1
CASEFILE_DB_PORT=3306
CASEFILE_DOMAIN_DB=casefile_domain
CASEFILE_GRAPH_DB=casefile_graph

# Creates tables and loads data. Used by setup and load scripts only.
CASEFILE_LOADER_USER=casefile_loader
CASEFILE_LOADER_PASSWORD=

# Read-only, and only on policies, prior claims and the repair cost
# reference. Used by the agents' SQL tools.
CASEFILE_AGENT_USER=casefile_agent
CASEFILE_AGENT_PASSWORD=

# The system's account for the human gate: stores recommendations and
# write-backs. It cannot approve anything.
CASEFILE_WRITER_USER=casefile_writer
CASEFILE_WRITER_PASSWORD=

# The person's account: records approvals and rejections.
CASEFILE_APPROVER_USER=casefile_approver
CASEFILE_APPROVER_PASSWORD=

# Stores the checkpoints of each run in CASEFILE_GRAPH_DB. It cannot see the
# domain data.
CASEFILE_GRAPH_USER=casefile_graph
CASEFILE_GRAPH_PASSWORD=
